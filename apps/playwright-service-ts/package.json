{
  "name": "playwright-scraper-api",
  "version": "1.0.0",
  "description": "browser rendering service with playwright",
  "main": "api.ts",
  "scripts": {
    "start": "node dist/api.js",
    "build": "tsc",
    "dev": "tsx api.ts",
    "test": "node --import tsx --test --test-force-exit helpers/*.spec.ts",
    "test:integration": "node --import tsx --test integration/*.spec.ts",
    "benchmark:bots": "tsx scripts/benchmark-bot-detection.ts",
    "benchmark:waf": "tsx scripts/benchmark-waf.ts",
    "benchmark:api": "tsx scripts/benchmark-api.ts",
    "benchmark:api:audit": "tsx scripts/audit-api-benchmark.ts",
    "benchmark:reliability": "tsx scripts/benchmark-reliability.ts"
  },
  "keywords": [],
  "author": "Jeff Pereira",
  "license": "ISC",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@duckduckgo/autoconsent": "17.3.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "ipaddr.js": "^2.3.0",
    "patchright": "1.64.2",
    "playwright": "^1.64.1",
    "proxy-chain": "^2.7.1",
    "rebrowser-playwright": "1.64.101",
    "tldts": "7.4.19"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.30",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.4.0"
}
